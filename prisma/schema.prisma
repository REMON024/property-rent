// Production database schema (PostgreSQL). Matches SRS section 5.2.
// The app currently runs on dummy data in src/lib/data.ts; replace those
// functions with Prisma queries once DATABASE_URL is set and you run `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RENTER
  OWNER
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  DRAFT
  IN_REVIEW
  LIVE
  PAUSED
  RENTED
}

enum TenantType {
  FAMILY
  BACHELOR
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  RENTED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  REFUND
  PAYOUT
}

model Market {
  code             String   @id // BD, AE, MY
  name             String
  currency         String
  languages        String[]
  paymentProviders String[]
  idDocuments      String[]
  bookingFeePct    Decimal  @db.Decimal(5, 2)
  live             Boolean  @default(false)
  listings         Listing[]
}

model User {
  id        String     @id @default(cuid())
  phone     String     @unique
  email     String?    @unique
  name      String
  locale    String     @default("en")
  roles     Role[]
  kycStatus KycStatus  @default(NONE)
  createdAt DateTime   @default(now())
  listings  Listing[]
  bookings  Booking[]
  kyc       KycRecord[]
  reviews   Review[]
}

model KycRecord {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  country        String
  documentType   String
  documentNumber String // store encrypted at rest
  dateOfBirth    DateTime?
  expiry         DateTime?
  frontUrl       String?
  backUrl        String?
  selfieUrl      String?
  nameMatches    Boolean?
  faceMatch      String?
  status         KycStatus @default(PENDING)
  reason         String?
  reviewedById   String?
  submittedAt    DateTime  @default(now())
  reviewedAt     DateTime?
}

model Listing {
  id            Int            @id @default(autoincrement())
  owner         User           @relation(fields: [ownerId], references: [id])
  ownerId       String
  market        Market         @relation(fields: [marketCode], references: [code])
  marketCode    String
  title         String
  description   String
  city          String
  area          String
  address       String // house number hidden until a booking is confirmed
  lat           Float
  lng           Float
  rent          Int
  advance       Int
  serviceCharge Int            @default(0)
  currency      String
  bedrooms      Int
  bathrooms     Int
  sizeSqft      Int?
  floor         String?
  tenantType    TenantType
  facilities    String[]
  availableFrom DateTime
  minStayMonths Int
  status        ListingStatus  @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  photos        ListingPhoto[]
  bookings      Booking[]

  @@index([marketCode, city, area, status])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  url       String
  sortOrder Int
  isCover   Boolean @default(false)
  hash      String // perceptual hash for duplicate-photo checks
}

model Booking {
  id          String        @id @default(cuid())
  listing     Listing       @relation(fields: [listingId], references: [id])
  listingId   Int
  renter      User          @relation(fields: [renterId], references: [id])
  renterId    String
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(REQUESTED)
  expiresAt   DateTime? // owner reply or payment deadline
  createdAt   DateTime      @default(now())
  payments    Payment[]
  review      Review?

  @@index([listingId, status])
}

model Payment {
  id          String      @id @default(cuid())
  booking     Booking     @relation(fields: [bookingId], references: [id])
  bookingId   String
  type        PaymentType
  amount      Int
  currency    String
  provider    String // bkash, nagad, stripe…
  providerRef String      @unique
  status      String
  createdAt   DateTime    @default(now())
}

model Review {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @unique
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())
}
